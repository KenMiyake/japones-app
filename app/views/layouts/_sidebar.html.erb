<%# Fondo oscuro detrás del cajón (solo móvil) %>
<div data-action="click->sidebar#close" aria-hidden="true"
     class="pointer-events-none fixed inset-0 z-30 bg-sumi/30 opacity-0 transition-opacity duration-300 motion-reduce:transition-none
            group-data-open/sidebar:pointer-events-auto group-data-open/sidebar:opacity-100 lg:hidden print:hidden"></div>

<aside id="sidebar" aria-label="Navegación principal"
       class="fixed inset-y-0 left-0 z-40 flex w-sidebar flex-col overflow-x-hidden border-r border-sumi/10 bg-kinari
              transition-[width,translate] duration-300 ease-out motion-reduce:transition-none
              max-lg:-translate-x-full max-lg:group-data-open/sidebar:translate-x-0 max-lg:group-data-open/sidebar:shadow-xl
              lg:group-data-collapsed/sidebar:w-sidebar-collapsed print:hidden">

  <div class="flex h-20 items-center justify-between px-[1.125rem]">
    <%= render "layouts/brand" %>

    <%# Cerrar el cajón (móvil) %>
    <button type="button" data-action="sidebar#close" aria-label="Cerrar menú"
            class="grid size-8 place-items-center rounded-md text-sumi/50 transition-colors hover:bg-sumi/[0.05] hover:text-sumi lg:hidden">✕</button>
  </div>

  <nav class="flex-1 overflow-y-auto overflow-x-hidden px-3 py-4">
    <ul class="space-y-1">
      <% nav_items.each do |item| %>
        <% active = nav_item_active?(item) %>
        <li>
          <%= content_tag(item.path ? :a : :span,
                href: item.path,
                title: item.label,
                data: { tour: item.key },
                "aria-current": (active ? "page" : nil),
                "aria-disabled": (item.path ? nil : "true"),
                class: ["group/item relative flex items-center gap-3 rounded-md py-2 pl-1.5 pr-2 transition-colors duration-200",
                        "before:absolute before:left-0 before:top-1/2 before:h-5 before:w-[3px] before:-translate-y-1/2 before:rounded-full before:bg-shu",
                        "before:origin-center before:scale-y-0 before:transition-transform before:duration-300 motion-reduce:before:transition-none",
                        active ? "bg-sumi/[0.06] text-sumi before:scale-y-100" : "",
                        item.path && !active ? "text-sumi/75 hover:bg-sumi/[0.04] hover:text-sumi" : "",
                        item.path ? "" : "cursor-default text-sumi/35"]) do %>
            <span class="grid size-9 shrink-0 place-items-center font-kanji text-[15px] tracking-tight
                         <%= active ? "text-shu" : "" %>"><%= item.kanji %></span>
            <span class="flex flex-1 items-center justify-between gap-2 whitespace-nowrap text-sm transition-opacity duration-200 motion-reduce:transition-none
                         lg:group-data-collapsed/sidebar:opacity-0">
              <%= item.label %>
              <% unless item.path %>
                <span class="text-[10px] uppercase tracking-widest text-sumi/30">pronto</span>
              <% end %>
            </span>
          <% end %>
        </li>
      <% end %>
    </ul>
  </nav>

</aside>

<%# Colapsar / expandir (escritorio): botón redondo montado sobre el borde del sidebar, arriba.
    Va fuera del <aside> (que recorta lo que sobresale) y se desliza junto con el borde. %>
<button type="button" data-action="sidebar#toggleCollapsed" data-sidebar-target="toggle" data-tour="collapse"
        aria-controls="sidebar" aria-expanded="<%= !sidebar_collapsed? %>"
        aria-label="Colapsar o expandir el menú" title="Colapsar o expandir el menú"
        class="fixed top-7 z-50 hidden size-6 place-items-center rounded-full border border-sumi/15 bg-washi text-sumi/60 shadow-sm
               transition-[left,color,border-color] duration-300 ease-out hover:border-shu/40 hover:text-shu motion-reduce:transition-none
               left-[calc(var(--spacing-sidebar)-0.75rem)] lg:grid
               lg:group-data-collapsed/sidebar:left-[calc(var(--spacing-sidebar-collapsed)-0.75rem)] print:hidden">
  <svg class="size-3.5 transition-transform duration-300 motion-reduce:transition-none lg:group-data-collapsed/sidebar:rotate-180"
       viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true">
    <path d="M10 3.5 5.5 8l4.5 4.5" stroke-linecap="round" stroke-linejoin="round" />
  </svg>
</button>
