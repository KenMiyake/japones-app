<!DOCTYPE html>
<html lang="es">
  <head>
    <title><%= content_for(:title) || "Japonés" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="application-name" content="Japonés">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Noto+Sans+JP:wght@400;500;700&family=Noto+Serif+JP:wght@500;700&display=swap">

    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="min-h-screen bg-stone-50 text-stone-900 antialiased">
    <header class="border-b border-stone-200 bg-white print:hidden">
      <nav class="mx-auto flex max-w-6xl items-center gap-6 px-5 py-3">
        <%= link_to root_path, class: "flex items-baseline gap-2" do %>
          <span class="font-kanji text-2xl">漢字</span>
          <span class="font-medium">Japonés</span>
        <% end %>
        <%= link_to "Plan", plan_weeks_path, class: "text-sm text-stone-600 hover:text-stone-900" %>
      </nav>
    </header>

    <main class="mx-auto max-w-6xl px-5 py-8">
      <%= yield %>
    </main>
  </body>
</html>
