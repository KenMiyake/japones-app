<!DOCTYPE html>
<html lang="es">
  <head>
    <title><%= content_for(:title) || "Japonés" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="application-name" content="Japonés">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Noto+Sans+JP:wght@400;500;700&family=Noto+Serif+JP:wght@500;700&display=swap">

    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <%# Estado del sidebar en el body: data-collapsed (escritorio) y data-open (móvil). %>
  <%= tag.body class: "group/sidebar min-h-screen bg-washi font-sans text-sumi antialiased",
               data: { controller: "sidebar", action: "keydown.esc@window->sidebar#close",
                       collapsed: (sidebar_collapsed? ? "" : nil) } do %>
    <%= render "layouts/sidebar" %>

    <div class="min-h-screen transition-[padding] duration-300 ease-out motion-reduce:transition-none
                lg:pl-sidebar lg:group-data-collapsed/sidebar:pl-sidebar-collapsed print:pl-0">
      <%= render "layouts/topbar" %>

      <main class="mx-auto max-w-6xl px-6 py-10 lg:px-12 lg:py-12">
        <%= yield %>
      </main>
    </div>
  <% end %>
</html>
