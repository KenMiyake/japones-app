<%# Encabezado de página: kanji y lectura arriba, título en serif y bajada opcional. %>
<%# locals: (kanji:, reading:, title:, subtitle: nil) -%>
<header class="mb-10">
  <p class="flex items-baseline gap-3 text-nezumi">
    <span class="font-kanji text-sm tracking-[0.3em] text-shu"><%= kanji %></span>
    <span class="text-xs tracking-[0.2em]"><%= reading %></span>
  </p>
  <h1 class="mt-2 font-kanji text-3xl font-bold tracking-wide"><%= title %></h1>
  <% if subtitle %>
    <p class="mt-2 text-nezumi"><%= subtitle %></p>
  <% end %>
  <div class="mt-6 h-px w-16 bg-sumi/20"></div>
</header>
