<% content_for :title, "#{@kanji.character} · Kanji" %>
<% content_for :breadcrumbs, breadcrumbs([ "Kanji", kanjis_path ], [ @kanji.character ]) %>

<div class="grid gap-10 md:grid-cols-[16rem_1fr] lg:gap-14">
  <%# Kanji grande sobre la cruz de guía %>
  <div>
    <div class="kanji-guide grid aspect-square place-items-center rounded-md border border-sumi/15 bg-white/70">
      <span class="font-kanji text-[9rem] leading-none"><%= @kanji.character %></span>
    </div>
    <div class="mt-4 flex gap-2 print:hidden">
      <%= link_to "Editar", edit_kanji_path(@kanji), class: ui_button_class(:secondary, "flex-1") %>
      <%= button_to "Eliminar", kanji_path(@kanji), method: :delete, form_class: "flex-1",
            class: ui_button_class(:danger, "w-full"),
            data: { turbo_confirm: "¿Eliminar el kanji #{@kanji.character} y sus lecturas?" } %>
    </div>
  </div>

  <div>
    <p class="flex items-baseline gap-3 text-nezumi">
      <span class="font-kanji text-sm tracking-[0.3em] text-shu">意味</span>
      <span class="text-xs tracking-[0.2em]">いみ</span>
    </p>
    <h1 class="mt-2 font-kanji text-3xl font-bold tracking-wide <%= "text-sumi/30" unless @kanji.meaning_es %>">
      <%= @kanji.meaning_es || "Sin significado" %>
    </h1>
    <% if @kanji.known? || @kanji.missing_fields.any? %>
      <div class="mt-3 flex flex-wrap gap-1.5">
        <%= badge "sabido desde el #{l(@kanji.known_mark.marked_on, format: '%-d %b')}", tone: :accent if @kanji.known? %>
        <%= missing_field_badges(@kanji) %>
      </div>
    <% end %>
    <div class="mt-6 h-px w-16 bg-sumi/20"></div>

    <dl class="mt-8 grid grid-cols-[6rem_1fr] gap-x-6 gap-y-5 text-sm">
      <dt class="text-xs uppercase tracking-[0.2em] text-nezumi">On</dt>
      <dd class="flex flex-wrap gap-x-4 gap-y-1 text-lg">
        <% if @kanji.on_readings.any? %>
          <% @kanji.on_readings.each do |reading| %><%= reading_tag(reading) %><% end %>
        <% else %>
          <span class="text-sm text-sumi/30">—</span>
        <% end %>
      </dd>

      <dt class="text-xs uppercase tracking-[0.2em] text-nezumi">Kun</dt>
      <dd class="flex flex-wrap gap-x-4 gap-y-1 text-lg">
        <% if @kanji.kun_readings.any? %>
          <% @kanji.kun_readings.each do |reading| %><%= reading_tag(reading) %><% end %>
        <% else %>
          <span class="text-sm text-sumi/30">—</span>
        <% end %>
      </dd>

      <dt class="text-xs uppercase tracking-[0.2em] text-nezumi">Semana</dt>
      <dd>
        <% if @kanji.plan_week %>
          <%= link_to @kanji.plan_week.code, plan_week_path(@kanji.plan_week), class: "font-medium hover:text-shu" %>
          <span class="text-nezumi"> · <%= @kanji.plan_week.lessons_label %></span>
        <% else %>
          <span class="text-sumi/40">Sin semana (kanji de referencia)</span>
        <% end %>
      </dd>

      <dt class="text-xs uppercase tracking-[0.2em] text-nezumi">Lección</dt>
      <dd>
        <% if @kanji.lesson %>
          <span class="font-medium"><%= @kanji.lesson.code %></span>
          <% if @kanji.lesson_outside_plan_week? %>
            <span class="ml-2 text-kincha">fuera del rango de <%= @kanji.plan_week.code %></span>
          <% end %>
        <% else %>
          <span class="text-sumi/40">Sin lección</span>
        <% end %>
      </dd>
    </dl>

    <% if @kanji.srs_cards.any? %>
      <section id="kanji_cards" class="mt-10">
        <h2 class="mb-3 text-xs font-medium uppercase tracking-[0.2em] text-nezumi">Repaso</h2>
        <ul class="divide-y divide-sumi/10 border-y border-sumi/10 text-sm">
          <% @kanji.srs_cards.sort_by(&:new_rank).each do |card| %>
            <li id="<%= dom_id(card) %>" class="flex flex-wrap items-center gap-x-4 gap-y-1 py-2.5">
              <span class="w-16 font-medium"><%= card_type_label(card) %></span>
              <span class="text-nezumi"><%= card_state_label(card) %></span>
              <span class="text-nezumi">· <%= card_due_label(card) %></span>
              <% if card.lapses.positive? %>
                <span class="text-kincha">· olvidada <%= pluralize(card.lapses, "vez", plural: "veces") %></span>
              <% end %>
              <% unless card.state_new? %>
                <%= button_to "Olvidado", forgot_kanji_card_path(@kanji, card.card_type), method: :post,
                      form_class: "ml-auto print:hidden",
                      class: "rounded px-2 py-1 text-xs text-shu transition-colors hover:bg-shu/[0.06]",
                      data: { turbo_confirm: "¿Marcar #{@kanji.character} (#{card_type_label(card)}) como olvidado? Volverá hoy." } %>
              <% end %>
            </li>
          <% end %>
        </ul>
      </section>
    <% end %>

    <section class="mt-10">
      <h2 class="mb-3 text-xs font-medium uppercase tracking-[0.2em] text-nezumi">Mnemotecnia</h2>
      <% if @kanji.mnemonic %>
        <p class="whitespace-pre-line border-l-2 border-shu/40 pl-4 leading-relaxed"><%= @kanji.mnemonic %></p>
      <% else %>
        <p class="text-sumi/30">Todavía no hay mnemotecnia.</p>
      <% end %>
    </section>

    <% if @kanji.components.any? %>
      <section class="mt-8">
        <h2 class="mb-3 text-xs font-medium uppercase tracking-[0.2em] text-nezumi">Piezas</h2>
        <ul class="flex flex-wrap gap-2">
          <% @kanji.components.each do |component| %>
            <li>
              <%= link_to components_path(anchor: dom_id(component)), title: component.meaning_es,
                    class: "inline-flex items-baseline gap-2 rounded-full border border-sumi/15 bg-white/70 px-3 py-1 text-sm transition-colors hover:border-shu/40" do %>
                <% if component.character %><span class="font-kanji text-base"><%= component.character %></span><% end %>
                <% if component.name %><span class="text-nezumi"><%= component.name %></span><% end %>
              <% end %>
            </li>
          <% end %>
        </ul>
      </section>
    <% end %>

    <section class="mt-8">
      <div class="mb-3 flex items-baseline gap-3">
        <h2 class="text-xs font-medium uppercase tracking-[0.2em] text-nezumi">Palabras</h2>
        <%= link_to "＋ Agregar", new_word_path(text: @kanji.character, return_to_kanji: @kanji.character),
              class: "ml-auto text-sm text-nezumi transition-colors hover:text-shu print:hidden" %>
      </div>
      <% if @kanji.words.any? %>
        <ul class="divide-y divide-sumi/10 border-y border-sumi/10">
          <% @kanji.words.sort_by(&:reading).each do |word| %>
            <li class="flex items-baseline gap-4 py-2.5">
              <span class="font-kanji text-xl"><%= word_with_highlight(word, @kanji.character) %></span>
              <span class="text-sm text-nezumi" lang="ja"><%= word.reading %></span>
              <span class="text-sm"><%= word.meaning_es %></span>
              <%= link_to "Editar", edit_word_path(word), class: "ml-auto text-xs text-nezumi hover:text-sumi print:hidden" %>
            </li>
          <% end %>
        </ul>
      <% else %>
        <p class="text-sm text-sumi/30">Todavía no hay palabras con este kanji.</p>
      <% end %>
    </section>

    <% if @kanji.confusable_groups.any? %>
      <section class="mt-8">
        <h2 class="mb-3 text-xs font-medium uppercase tracking-[0.2em] text-nezumi">Se confunde con</h2>
        <ul class="flex flex-wrap gap-3">
          <% @kanji.confusable_groups.each do |group| %>
            <li class="flex items-center gap-3 rounded-md border border-sumi/10 bg-white/60 px-3 py-2">
              <span class="font-kanji text-xl">
                <% group.kanjis.each_with_index do |kanji, index| %>
                  <% if index.positive? %><span class="text-sumi/20">／</span><% end %>
                  <% if kanji == @kanji %>
                    <span class="text-shu"><%= kanji.character %></span>
                  <% else %>
                    <%= link_to kanji.character, kanji_path(kanji), class: "hover:text-shu" %>
                  <% end %>
                <% end %>
              </span>
              <%= practice_mode_badge(group) %>
            </li>
          <% end %>
        </ul>
      </section>
    <% end %>

    <% if @kanji.notes %>
      <section class="mt-8">
        <h2 class="mb-3 text-xs font-medium uppercase tracking-[0.2em] text-nezumi">Notas</h2>
        <p class="whitespace-pre-line leading-relaxed text-sumi/80"><%= @kanji.notes %></p>
      </section>
    <% end %>
  </div>
</div>
