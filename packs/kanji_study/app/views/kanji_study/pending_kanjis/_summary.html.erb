<%# Resumen de lo que falta, con filtros por campo. %>
<%# locals: (query:) -%>
<% total = query.total %>
<% incomplete = query.incomplete_count %>
<div id="pending_summary" class="mb-8">
  <p class="text-sm text-nezumi">
    <span class="font-kanji text-2xl font-bold text-sumi"><%= incomplete %></span>
    de <%= total %> kanji por completar
  </p>
  <div class="mt-3 h-[3px] max-w-md overflow-hidden rounded-full bg-sumi/10" role="progressbar"
       aria-valuemin="0" aria-valuemax="<%= total %>" aria-valuenow="<%= total - incomplete %>" aria-label="Kanji completos">
    <div class="h-full rounded-full bg-matcha transition-[width] duration-500 ease-out motion-reduce:transition-none"
         style="width: <%= total.zero? ? 0 : ((total - incomplete) * 100.0 / total).round(1) %>%"></div>
  </div>

  <nav aria-label="Filtrar por lo que falta" class="mt-4 flex flex-wrap gap-1.5">
    <%= link_to "Todo lo pendiente", pending_kanjis_path(query.to_params(missing: nil)),
          "aria-current": (query.missing.nil? ? "page" : nil),
          class: [ "rounded-full px-3 py-1 text-xs transition-colors",
                   query.missing.nil? ? "bg-sumi text-washi" : "text-nezumi ring-1 ring-sumi/15 hover:text-sumi" ] %>
    <% query.counts_by_field.each do |field, count| %>
      <% active = query.missing == field.to_s %>
      <%= link_to pending_kanjis_path(query.to_params(missing: field)),
            "aria-current": (active ? "page" : nil),
            class: [ "rounded-full px-3 py-1 text-xs transition-colors",
                     active ? "bg-sumi text-washi" : "text-nezumi ring-1 ring-sumi/15 hover:text-sumi" ] do %>
        <%= t("kanji_study.missing_fields.#{field}") %> <span class="ml-0.5 font-medium"><%= count %></span>
      <% end %>
    <% end %>
  </nav>
</div>
