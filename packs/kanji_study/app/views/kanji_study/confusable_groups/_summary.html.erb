<%# Resumen por modo de práctica. %>
<% counts = practice_mode_counts %>
<p id="confusable_summary" class="mb-10 flex flex-wrap items-center gap-x-5 gap-y-2 text-sm text-nezumi">
  <span><span class="font-kanji text-2xl font-bold text-sumi"><%= counts.values.sum %></span> grupos</span>
  <% KanjiStudy::ConfusableGroup.practice_modes.each_key do |mode| %>
    <span class="flex items-center gap-1.5">
      <span class="font-medium text-sumi"><%= counts.fetch(mode, 0) %></span> <%= practice_mode_label(mode) %>
    </span>
  <% end %>
</p>
