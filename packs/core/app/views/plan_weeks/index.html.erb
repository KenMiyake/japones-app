<% content_for :title, "Plan de estudio · Japonés" %>
<% content_for :breadcrumbs, breadcrumbs([ "Plan de estudio" ]) %>

<%= render "shared/page_header", kanji: "計画", reading: "けいかく", title: "Plan de estudio",
           subtitle: safe_join([ "Ocho semanas de kanji siguiendo ", tag.em("Minna no Nihongo I"), "." ]) %>

<% if @plan_weeks.empty? %>
  <p class="rounded-md border border-dashed border-sumi/20 p-8 text-nezumi">
    Todavía no hay semanas cargadas. Ejecuta <code class="font-mono text-sumi">bin/rails db:seed</code>.
  </p>
<% else %>
  <ol class="grid gap-5 sm:grid-cols-2 xl:grid-cols-4">
    <% @plan_weeks.each do |week| %>
      <li id="<%= dom_id(week) %>">
        <%= link_to plan_week_path(week),
              class: ["group/card relative flex h-full flex-col overflow-hidden rounded-md border bg-white/60 p-6",
                      "transition duration-300 ease-out hover:-translate-y-0.5 hover:bg-white hover:shadow-[0_8px_24px_-12px_rgb(36_34_31/0.25)]",
                      "motion-reduce:transition-none motion-reduce:hover:translate-y-0",
                      week.current? ? "border-shu/40" : "border-sumi/10 hover:border-sumi/25"] do %>
          <% if week.current? %>
            <span class="absolute inset-y-0 left-0 w-[3px] bg-shu" aria-hidden="true"></span>
          <% end %>

          <div class="flex items-start justify-between gap-2">
            <span class="font-kanji text-3xl font-bold tracking-wide"><%= week.code %></span>
            <div class="flex flex-col items-end gap-1.5">
              <%= badge "esta semana", tone: :accent if week.current? %>
              <%= badge "provisional", tone: :warning if week.provisional? %>
            </div>
          </div>

          <div class="mt-auto pt-8">
            <p class="font-medium tracking-wide"><%= week.lessons_label %></p>
            <p class="mt-0.5 text-sm text-nezumi"><%= date_range(week.starts_on, week.ends_on) %></p>
          </div>
        <% end %>
      </li>
    <% end %>
  </ol>
<% end %>
